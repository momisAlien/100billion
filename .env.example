# Configure these in Vercel > Project > Settings > Environment Variables.
# Use the same Redis database and ROOM_KEY for every deployment sharing this table.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ROOM_CODE=
ROOM_KEY=maison:friends:room:v2
# Local development: optional. Defaults to MAISON3 if no ROOM_CODE is set.
PORT=4181

# Recommended: connect Neon in Vercel Marketplace (no custom variable prefix).
# DATABASE_URL is added by the integration. POSTGRES_URL is also supported.
DATABASE_URL=
# Optional: isolate production and preview rooms.
ROOM_KEY=maison:friends:v3
PORT=4181
# Legacy Upstash is still supported when DATABASE_URL is not set.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
